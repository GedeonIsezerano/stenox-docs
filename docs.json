{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stenox Docs",
  "seo": {
    "metatags": {
      "og:site_name": "Stenox Docs",
      "og:description": "Guides to Stenox dictation, local models, meeting capture, and notes on Mac."
    }
  },
  "colors": {
    "primary": "#255BD9",
    "light": "#93B4FF",
    "dark": "#255BD9"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "installation",
              "first-dictation",
              "pricing/overview"
            ]
          },
          {
            "group": "Notetaker",
            "pages": [
              "meetings/overview",
              "meetings/conversation",
              "meetings/notes",
              "meetings/references-and-ask",
              "meetings/calendar",
              "meetings/processing",
              "meetings/exports"
            ]
          },
          {
            "group": "Make it yours",
            "pages": [
              "profiles/overview",
              "profiles/creating-profiles",
              "profiles/auto-activation",
              "profiles/system-prompts",
              "setup/hotkeys",
              "setup/vocabulary",
              "setup/file-transcription"
            ]
          },
          {
            "group": "Models and providers",
            "pages": [
              "providers/overview",
              "setup/models",
              "providers/local-privacy",
              {
                "group": "Local speech",
                "pages": [
                  "providers/transcription/parakeet-local",
                  "providers/transcription/whisperkit-local",
                  "providers/transcription/cohere-local"
                ]
              },
              {
                "group": "Cloud speech",
                "pages": [
                  "providers/cloud-byok",
                  "setup/byok-configuration",
                  "providers/transcription/deepgram",
                  "providers/transcription/assemblyai",
                  "providers/transcription/openai-whisper",
                  "providers/transcription/gemini-transcribe"
                ]
              },
              {
                "group": "Dictation Polish",
                "pages": [
                  "providers/llm/mlx-local",
                  "providers/llm/google-gemini"
                ]
              }
            ]
          },
          {
            "group": "Help",
            "pages": [
              "guides/privacy-first-setup",
              "guides/cloud-setup",
              "guides/troubleshooting",
              "support/overview",
              "support/feedback"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Stenox website",
          "href": "https://stenox.app",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://stenox.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://stenox.app/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Explore Stenox",
      "href": "https://stenox.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/pricing/free-tier",
      "destination": "/pricing/overview"
    },
    {
      "source": "/pricing/plus-subscription",
      "destination": "/pricing/overview"
    },
    {
      "source": "/pricing/lifetime",
      "destination": "/pricing/overview"
    },
    {
      "source": "/setup/license",
      "destination": "/pricing/overview"
    },
    {
      "source": "/providers/transcription/stenox-cloud",
      "destination": "/providers/overview"
    },
    {
      "source": "/providers/llm/stenox-cloud-llm",
      "destination": "/providers/overview"
    }
  ],
  "footer": {
    "links": [
      {
        "header": "Stenox",
        "items": [
          {
            "label": "Privacy",
            "href": "https://stenox.app/privacy"
          },
          {
            "label": "Terms",
            "href": "https://stenox.app/terms"
          },
          {
            "label": "Third-party licenses",
            "href": "https://stenox.app/licenses"
          },
          {
            "label": "Support",
            "href": "https://stenox.app/support"
          }
        ]
      }
    ],
    "socials": {
      "x": "https://x.com/stenoxapp"
    }
  },
  "background": {
    "color": {
      "light": "#F5F3EA",
      "dark": "#11151D"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Satoshi",
      "source": "/fonts/Satoshi-Medium.woff2",
      "format": "woff2",
      "weight": 500
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "banner": {
    "content": "Development build docs \u00b7 Check [release and access](/pricing/overview) for public availability.",
    "dismissible": false
  },
  "ignore": [
    "README.md",
    "CLAUDE.md",
    "maintenance/**",
    "scripts/**"
  ]
}
